# BNU Sparks 环境变量样例 —— 复制为 .env 并填入真实值
# .env 永不提交（已在 .gitignore 中）。
# 注意：settings.py 的 .env 解析要求「KEY="值"」双引号格式。

# ── 必填 ──
# Django 签名密钥：python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY="change-me"

# ── 可选：上传限制 ──
# 单文件上传上限（字节，默认 50MB）
# MAX_UPLOAD_FILE_SIZE="52428800"

# ── 可选：邮件（注册验证 / 找回密码）──
# SMTP 密码
# EMAIL_PASSWORD="your-smtp-password"

# ── 生产环境（bnusparks/settings_prod.py）──
# 允许的主机（逗号分隔，无空格）
# DJANGO_ALLOWED_HOSTS="your-domain.cn,www.your-domain.cn,localhost,127.0.0.1"
